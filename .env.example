# NETRA configuration template
# Copy to .env (root) and/or backend/.env and frontend/.env as needed.
# Do not commit real secrets.

# Neo4j (network digital twin)
NEO4J_AUTH=neo4j/netra_password
NEO4J_USER=neo4j
NEO4J_PASSWORD=netra_password
NEO4J_URI=bolt://localhost:7687
NEO4J_URI_DOCKER=bolt://neo4j:7687

# NETRA FastAPI backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NETRA React frontend
VITE_API_BASE_URL=http://localhost:8000

# Sample infrastructure (source-infrastructure/network-infra/.env)
SOURCE_DB_NAME=college_app
SOURCE_DB_USER=app_user
SOURCE_DB_PASSWORD=local_demo_password
