# Sample infrastructure database
SOURCE_DB_NAME=college_app
SOURCE_DB_USER=app_user
SOURCE_DB_PASSWORD=local_demo_password

# Neo4j (network digital twin)
# Keep NEO4J_AUTH, NEO4J_USER and NEO4J_PASSWORD consistent.
NEO4J_AUTH=neo4j/netra_password
NEO4J_USER=neo4j
NEO4J_PASSWORD=netra_password
NEO4J_URI_DOCKER=bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
